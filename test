//genrating signature to verify the paymnet received 
const generateSignature = (paymentId, orderId, secret) => {
  const data = ${orderId}|${paymentId};
  const hmac = crypto.createHmac("sha256", secret);
  hmac.update(data);
  const signature = hmac.digest("hex");
  return signature;
};
